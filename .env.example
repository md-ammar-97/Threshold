# Copy to .env and fill in real values. Never commit the real .env file.
# Variable names mirror architecture.md §28.2 exactly.

# --- Core ---
# Host-side ports (5434/6381/8010) are non-default to avoid colliding with
# other unrelated projects' containers already running on this machine on
# the conventional 5432/6379/8000. Adjust *_HOST_PORT if these also collide
# for you; container-internal ports are unaffected.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://instamart:instamart@localhost:5434/instamart
REDIS_URL=redis://localhost:6381/0
# Comma-separated allowed frontend origins for CORS. Add your deployed
# Vercel URL(s) in production, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://instamart-discovery-engine.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Postgres (used by docker-compose to init the container) ---
POSTGRES_USER=instamart
POSTGRES_PASSWORD=instamart
POSTGRES_DB=instamart
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
API_HOST_PORT=8010
FRONTEND_HOST_PORT=3000

# --- Raw artifact storage ---
# supabase: uses Supabase Storage's native REST API (service_role key only —
# no separate S3 access-key pair to provision). Get these from the Supabase
# dashboard: Project Settings > API (URL, service_role secret) and
# Storage (bucket name).
RAW_STORAGE_BACKEND=filesystem
RAW_STORAGE_PATH=./data/raw
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- LLM ---
# Groq (primary) and OpenRouter (automatic fallback) are both OpenAI-compatible.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openrouter
LLM_MODEL_CLASSIFICATION=openai/gpt-oss-120b
LLM_MODEL_SYNTHESIS=openai/gpt-oss-120b
LLM_MODEL_ANSWER=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Groq's hosted Whisper speech-to-text endpoint — media pipeline Phase 1.
LLM_MODEL_TRANSCRIPTION=whisper-large-v3-turbo
GROQ_API_KEY=
# Optional: a second Groq account's key, tried after the primary is
# rate-limited/quota-exhausted but before falling over to OpenRouter --
# effectively doubles the free-tier daily/per-minute token budget. Leave
# blank to skip this tier entirely.
GROQ_API_KEY_SECONDARY=
# Optional: a third Groq account's key, tried after both the primary and
# secondary accounts are exhausted but before falling over to OpenRouter.
# Leave blank to skip this tier entirely.
GROQ_API_KEY_TERTIARY=
OPENROUTER_API_KEY=

# --- Embeddings ---
# hosted: calls the Hugging Face Inference API instead of running the model
# locally — no model weights to download for a thin web deployment.
EMBEDDING_PROVIDER=hosted
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_API_TOKEN=

# --- Connectors ---
APIFY_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=instamart-discovery-engine/0.1

# --- Email (report export delivery) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@instamart-discovery-engine.dev

# --- Operational limits ---
DEFAULT_COLLECTION_LIMIT=500
MAX_COLLECTION_COST_USD=25.0
MODEL_MAX_RETRIES=3
MODEL_CONCURRENCY=4

# --- Frontend ---
# VITE_API_URL is set directly in docker-compose.yml (not read from .env);
# listed here only for reference when running the frontend outside Docker.
VITE_API_URL=http://localhost:8010
